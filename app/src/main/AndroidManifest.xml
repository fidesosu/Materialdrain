<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The host switcher checks the hosts again when the network changes, and knows when the device is offline -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Transfers keep running in the background as a foreground service with a progress notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Songs going on in the background (the Media setting), see PlaybackService -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Opening a downloaded APK hands it to the system installer, which quietly closes for an app without this -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Materialdrain"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- singleTask: one copy of the app, in its own task. A share from another app comes to it (onNewIntent) and opens
             its Upload screen, instead of a second copy on top of the sharing app, which the share could miss -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share" from another app: the shared files are uploaded to Pixeldrain; shared text with a Pixeldrain link
                 opens it, other text is uploaded as text (see PendingOpen) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Pixeldrain's links of a file (/u/…) and of a list (/l/…) can open in the app. Not verified as the app's own
                 (that's for the site to declare), so Android asks, or the user turns them on in the app's settings under
                 "Open by default" -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="pixeldrain.com" />
                <data android:host="www.pixeldrain.com" />
                <data android:host="pixeldrain.net" />
                <data android:pathPrefix="/u/" />
                <data android:pathPrefix="/l/" />
            </intent-filter>
        </activity>

        <!-- The hosts in the system's file picker, read only, when the setting is on (see HostDocumentsProvider). Only the
             system can reach it (MANAGE_DOCUMENTS), for the app the user picks a file in -->
        <provider
            android:name=".documents.HostDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- The Quick Settings tile which opens the upload screen -->
        <service
            android:name=".UploadTileService"
            android:exported="true"
            android:icon="@drawable/icon_upload"
            android:label="@string/upload_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".transfer.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The player of songs going on in the background, with their controls in the notification and on the lock screen.
             Exported as Media3 needs it to be, for the system's media controls to reach it -->
        <service
            android:name=".ui.media.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>