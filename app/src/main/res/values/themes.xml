<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The window's theme, behind the app's own (Compose, see ui/theme/Theme.kt), which colours everything drawn -->
    <style name="Theme.Materialdrain" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- While the app starts: the page's colour, light or dark as the system is, with the icon -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">?android:attr/colorBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon_padded</item>
        <item name="postSplashScreenTheme">@style/Theme.Materialdrain</item>
    </style>
</resources>
