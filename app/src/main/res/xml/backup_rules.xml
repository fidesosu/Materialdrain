<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- The login session key is encrypted with a Keystore key which is not part of a backup -->
    <exclude domain="sharedpref" path="pixeldrain_secure_prefs.xml" />
    <!-- The manually entered API key is encrypted in the secure file; the old plain copy is not backed up -->
    <exclude domain="sharedpref" path="pixeldrain_prefs.xml" />
</full-backup-content>
