[Unit]
Description=Update the Materialdrain website from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/materialdrain-site-sync

# Runs as root, so there's no extra user to look after, but in a sandbox: it can only write the site's folder, and it
# has none of root's powers (no overriding file permissions, no changing owners, no mounting...). It only needs to fetch
# from GitHub and write files it owns.
ReadWritePaths=/var/www/materialdrain
ProtectSystem=strict
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
# Home folders look empty to it; git then reads no one's own settings
ProtectHome=tmpfs
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# Only the network, to reach GitHub
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
